# ── Database ──────────────────────────────────────────────────────────────────
# Pilih SALAH SATU konfigurasi database di bawah ini.

# ── Opsi 1: MySQL Lokal (XAMPP) ──────────────────────────────────────────────
# Gunakan ini untuk instalasi lokal / development.
DATABASE_URL="mysql://root:@localhost:3306/poskesdes_db"

# Jika MySQL lokal pakai password:
# DATABASE_URL="mysql://root:password_anda@localhost:3306/poskesdes_db"

# ── Opsi 2: MySQL Cloud (Aiven / Railway / dll) ─────────────────────────────
# Gunakan ini untuk deploy ke Vercel atau hosting lainnya.
# Tambahkan parameter connection_limit dan connect_timeout untuk stabilitas.
# DATABASE_URL="mysql://username:password@hostname:port/poskesdes_db?sslaccept=accept_invalid_certs&connection_limit=1&connect_timeout=30"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -hex 32
BETTER_AUTH_SECRET="ganti-dengan-secret-random-minimal-32-karakter"

# Untuk lokal:
BETTER_AUTH_URL="http://localhost:3000"
# Untuk deploy (ganti dengan URL production):
# BETTER_AUTH_URL="https://nama-app.vercel.app"

# ── Aplikasi ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Sistem Diagnosis POSYANDU"

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
# Kredensial admin pertama yang dibuat saat setup.
ADMIN_NAME="Admin Posyandu"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@posyandu.local"
ADMIN_PASSWORD="password123"
