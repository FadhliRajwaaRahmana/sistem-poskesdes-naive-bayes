generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id              String           @id @default(cuid())
  name            String
  username        String           @unique
  displayUsername String?
  email           String           @unique
  emailVerified   Boolean          @default(true)
  image           String?
  role            Role             @default(ADMIN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  diagnosa        DiagnosaPasien[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Gejala {
  id             String            @id @default(cuid())
  kode           String            @unique
  nama           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  trainingGejala TrainingGejala[]
  diagnosaGejala DiagnosaGejala[]
}

model Penyakit {
  id              String            @id @default(cuid())
  kode            String            @unique
  nama            String
  deskripsi       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dataTraining    DataTraining[]
  diagnosa        DiagnosaPasien[]
  diagnosaRanking DiagnosaRanking[]
}

model DataTraining {
  id             String           @id @default(cuid())
  penyakitId     String
  createdAt      DateTime         @default(now())
  penyakit       Penyakit         @relation(fields: [penyakitId], references: [id], onDelete: Restrict)
  trainingGejala TrainingGejala[]

  @@index([penyakitId])
}

model TrainingGejala {
  id         String       @id @default(cuid())
  trainingId String
  gejalaId   String
  training   DataTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  gejala     Gejala       @relation(fields: [gejalaId], references: [id], onDelete: Restrict)

  @@unique([trainingId, gejalaId])
  @@index([gejalaId])
}

model DiagnosaPasien {
  id              String            @id @default(cuid())
  tanggal         DateTime
  namaPasien      String
  noKartu         String?
  umur            Int
  alamat          String?
  penyakitId      String?
  hasilDiagnosa   String
  keterangan      String?
  userId          String
  createdAt       DateTime          @default(now())
  penyakit        Penyakit?         @relation(fields: [penyakitId], references: [id], onDelete: SetNull)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  diagnosaGejala  DiagnosaGejala[]
  diagnosaRanking DiagnosaRanking[]

  @@index([tanggal])
  @@index([penyakitId])
  @@index([userId])
}

model DiagnosaGejala {
  id         String         @id @default(cuid())
  diagnosaId String
  gejalaId   String
  diagnosa   DiagnosaPasien @relation(fields: [diagnosaId], references: [id], onDelete: Cascade)
  gejala     Gejala         @relation(fields: [gejalaId], references: [id], onDelete: Restrict)

  @@unique([diagnosaId, gejalaId])
  @@index([gejalaId])
}

model DiagnosaRanking {
  id           String         @id @default(cuid())
  diagnosaId   String
  penyakitId   String?
  kodePenyakit String
  namaPenyakit String
  prior        Float
  posterior    Float
  score        Float
  peringkat    Int
  createdAt    DateTime       @default(now())
  diagnosa     DiagnosaPasien @relation(fields: [diagnosaId], references: [id], onDelete: Cascade)
  penyakit     Penyakit?      @relation(fields: [penyakitId], references: [id], onDelete: SetNull)

  @@index([diagnosaId])
  @@index([penyakitId])
  @@unique([diagnosaId, peringkat])
}
