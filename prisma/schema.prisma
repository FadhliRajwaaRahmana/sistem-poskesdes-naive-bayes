generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

// ──────────────────────────── Auth (Better Auth) ────────────────────────────

model User {
  id              String            @id @default(cuid())
  name            String
  username        String            @unique
  displayUsername String?
  email           String            @unique
  emailVerified   Boolean           @default(true)
  image           String?
  role            Role              @default(ADMIN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  accounts        Account[]
  diagnosis       DiagnosisBalita[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ──────────────────────────── Domain: Master Data ───────────────────────────

model Penyakit {
  id              String              @id @default(cuid())
  kode            String              @unique
  nama            String
  deskripsi       String?             @db.Text
  saranPenanganan String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  penyakitGejala  PenyakitGejala[]
  diagnosis       DiagnosisBalita[]
  diagnosisRanking DiagnosisRanking[]
}

model Gejala {
  id              String              @id @default(cuid())
  kode            String              @unique
  nama            String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  penyakitGejala  PenyakitGejala[]
  diagnosisGejala DiagnosisGejala[]
}

model PenyakitGejala {
  id         String   @id @default(cuid())
  penyakitId String
  gejalaId   String
  likelihood Float
  penyakit   Penyakit @relation(fields: [penyakitId], references: [id], onDelete: Cascade)
  gejala     Gejala   @relation(fields: [gejalaId], references: [id], onDelete: Cascade)

  @@unique([penyakitId, gejalaId])
  @@index([gejalaId])
}

model StandarPertumbuhan {
  id           String       @id @default(cuid())
  umurBulan    Int
  jenisKelamin JenisKelamin
  bbMin        Float
  bbMax        Float
  tbMin        Float
  tbMax        Float

  @@unique([umurBulan, jenisKelamin])
}

// ──────────────────────────── Domain: Diagnosis ─────────────────────────────

model DiagnosisBalita {
  id              String              @id @default(cuid())
  tanggal         DateTime
  namaBalita      String
  nik             String
  jenisKelamin    JenisKelamin
  namaIbu         String
  dusun           String
  tanggalLahir    DateTime?
  umurBulan       Int
  beratBadan      Float
  tinggiBadan     Float
  lila            Float?
  hasilDiagnosis  String
  penyakitId      String?
  keterangan      String?
  userId          String?
  createdAt       DateTime            @default(now())
  penyakit        Penyakit?           @relation(fields: [penyakitId], references: [id], onDelete: SetNull)
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  diagnosisGejala DiagnosisGejala[]
  diagnosisRanking DiagnosisRanking[]

  @@index([tanggal])
  @@index([penyakitId])
  @@index([userId])
  @@index([nik])
  @@index([dusun])
}

model DiagnosisGejala {
  id          String          @id @default(cuid())
  diagnosisId String
  gejalaId    String
  diagnosis   DiagnosisBalita @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  gejala      Gejala          @relation(fields: [gejalaId], references: [id], onDelete: Restrict)

  @@unique([diagnosisId, gejalaId])
  @@index([gejalaId])
}

model DiagnosisRanking {
  id           String          @id @default(cuid())
  diagnosisId  String
  penyakitId   String?
  kodePenyakit String
  namaPenyakit String
  prior        Float
  posterior     Float
  score        Float
  peringkat    Int
  createdAt    DateTime        @default(now())
  diagnosis    DiagnosisBalita @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  penyakit     Penyakit?       @relation(fields: [penyakitId], references: [id], onDelete: SetNull)

  @@index([diagnosisId])
  @@index([penyakitId])
  @@unique([diagnosisId, peringkat])
}
